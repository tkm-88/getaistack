---
const today = new Date();
---

<footer>
	<div class="footer-content">
		<p>&copy; {today.getFullYear()} <strong>Get AI Stack</strong>. All rights reserved.</p>
		<p class="disclaimer">
			Independent software reviews and AI toolkit guides for Indian businesses, creators, and freelancers.
		</p>
	</div>
</footer>
<style>
	footer {
		padding: 3em 1em 4em 1em;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		color: rgb(var(--gray));
		text-align: center;
		border-top: 1px solid rgba(var(--gray), 0.15);
		margin-top: 4em;
	}
	.footer-content {
		max-width: 720px;
		margin: 0 auto;
	}
	p {
		margin: 0.4em 0;
		font-size: 0.9em;
	}
	.disclaimer {
		font-size: 0.8em;
		color: rgb(var(--gray));
		opacity: 0.85;
	}
</style>