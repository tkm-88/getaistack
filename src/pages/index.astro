---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 960px;
			}
			.hero-section {
				text-align: center;
				padding: 3em 1em;
				background: linear-gradient(rgba(var(--accent-light), 0.08), rgba(var(--accent-light), 0.02));
				border-radius: 12px;
				margin-bottom: 2em;
			}
			.hero-section h1 {
				margin-bottom: 0.2em;
				font-size: 2.5em;
			}
			.hero-section p {
				font-size: 1.2em;
				color: rgb(var(--gray));
				max-width: 650px;
				margin: 0 auto;
			}
			.post-list {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
				gap: 1.5rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			.post-card {
				background: white;
				border: 1px solid rgba(var(--gray), 0.2);
				border-radius: 8px;
				padding: 1.5em;
				transition: transform 0.2s ease, box-shadow 0.2s ease;
			}
			.post-card:hover {
				transform: translateY(-3px);
				box-shadow: 0 4px 20px rgba(0,0,0,0.06);
			}
			.post-card a {
				text-decoration: none;
				color: inherit;
			}
			.post-card h4 {
				margin: 0.5em 0;
				font-size: 1.25em;
				line-height: 1.3;
			}
			.post-date {
				font-size: 0.85em;
				color: rgb(var(--gray));
			}
			.post-description {
				font-size: 0.95em;
				color: rgb(var(--gray-dark));
				line-height: 1.5;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="hero-section">
				<h1>🚀 Welcome to Get AI Stack</h1>
				<p>The curated software & AI directory for small businesses, creators, and freelancers in India.</p>
			</div>

			<section>
				<h2>Latest Guides & Stack Reviews</h2>
				<ul class="post-list">
					{
						posts.map((post) => (
							<li class="post-card">
								<a href={`/blog/${post.id}/`}>
									<span class="post-date">
										<FormattedDate date={post.data.pubDate} />
									</span>
									<h4>{post.data.title}</h4>
									<p class="post-description">{post.data.description}</p>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>